{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"]
  },
  "include": ["domain/**/*.ts", "services/**/*.ts", "fixtures/**/*.ts", "config/**/*.ts", "adapters/**/*.ts", "pages/**/*.ts", "app.ts"],
  "exclude": ["node_modules", "work", "tests", "vitest.config.ts"]
}
