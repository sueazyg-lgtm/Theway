{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "types": ["miniprogram-api-typings", "node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["domain/**/*.ts", "services/**/*.ts", "fixtures/**/*.ts", "config/**/*.ts", "adapters/**/*.ts", "pages/**/*.ts", "app.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "work"]
}
