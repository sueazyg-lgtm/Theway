@import '../../styles/workspace.wxss';

.home-screen { padding: 38rpx 30rpx calc(80rpx + env(safe-area-inset-bottom)); }
.home-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  padding: 18rpx 4rpx 26rpx;
}
.header-copy { min-width: 0; }
.home-header .heading { color: var(--moss-700); margin-bottom: 8rpx; font-size: 60rpx; }
.home-header .subheading { margin: 0; }
.header-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 -18rpx -10rpx 0;
  color: var(--moss-700);
  font-size: 28rpx;
  font-weight: 600;
}
.header-action:active { opacity: .54; }

.nature-hero {
  overflow: hidden;
  margin: 4rpx 0 28rpx;
  border: 1rpx solid rgba(117, 139, 112, .14);
  border-radius: 40rpx;
  background: var(--ivory-0);
  box-shadow: 0 20rpx 48rpx rgba(89, 82, 58, .09);
}
.hero-art { display: block; width: 100%; height: 292rpx; background: #f1e5cb; }
.hero-body { position: relative; padding: 27rpx 30rpx 30rpx; }
.hero-kicker {
  margin-bottom: 8rpx;
  color: var(--sunset-600);
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}
.hero-title { color: var(--ink-900); font-size: 35rpx; font-weight: 700; letter-spacing: -.7rpx; line-height: 1.3; }
.hero-description { margin-top: 9rpx; padding-right: 190rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.5; }
.hero-action {
  position: absolute;
  right: 28rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--sunset-400), var(--sunset-500) 58%, var(--sunset-600));
  box-shadow: 0 10rpx 20rpx rgba(217, 135, 56, .2);
  color: var(--ivory-0);
  font-size: 25rpx;
  font-weight: 650;
}
.hero-action:active { opacity: .76; transform: scale(.98); }

.local-mode {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  margin: 0 0 26rpx;
  padding: 0 6rpx;
}
.mode-indicator {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin: 0 18rpx 0 2rpx;
  border-radius: 50%;
  background: var(--moss-500);
  box-shadow: 0 0 0 8rpx rgba(117, 139, 112, .11);
}
.mode-title { font-size: 25rpx; font-weight: 600; line-height: 1.35; }
.mode-detail { margin-top: 2rpx; color: var(--color-tertiary); font-size: 22rpx; line-height: 1.35; }

.section { margin: 28rpx 8rpx 12rpx; }
.trip-list {
  overflow: hidden;
  border: 1rpx solid rgba(209, 209, 214, .9);
  border-radius: 30rpx;
  background: var(--color-surface);
  box-shadow: 0 14rpx 36rpx rgba(89, 82, 58, .055);
}
.trip-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 142rpx;
  padding: 22rpx 18rpx 22rpx 20rpx;
  transition: background-color 120ms ease;
}
.trip-row:active { background: var(--color-surface-secondary); }
.trip-row + .trip-row::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 26rpx;
  height: 1rpx;
  background: var(--color-separator);
  content: '';
}
.trip-marker { flex: 0 0 auto; width: 74rpx; height: 74rpx; margin-right: 20rpx; }
.trip-copy { flex: 1; min-width: 0; padding-right: 18rpx; }
.trip-title {
  overflow: hidden;
  margin-bottom: 8rpx;
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: -.3rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.trip-meta { color: var(--color-muted); font-size: 23rpx; line-height: 1.48; }
.trip-trailing { display: flex; flex: 0 0 auto; align-items: center; }
.archive-button,
.restore-button {
  width: auto;
  min-width: 72rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: var(--moss-700);
  font-size: 23rpx;
  font-weight: 500;
}
.row-chevron { width: 14rpx; height: 28rpx; margin: 0 8rpx 0 4rpx; }

.case-entry {
  margin: 22rpx 8rpx 8rpx;
  padding: 10rpx 0 0;
  text-align: center;
}
.case-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  color: var(--moss-700);
  font-size: 27rpx;
  font-weight: 550;
}
.case-link:active { opacity: .55; }
.case-note { color: var(--color-tertiary); font-size: 22rpx; line-height: 1.55; }

.empty-state {
  padding: 64rpx 38rpx 54rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 30rpx;
  background: var(--color-surface);
  box-shadow: 0 14rpx 36rpx rgba(89, 82, 58, .055);
  text-align: center;
}
.empty-title { margin-bottom: 8rpx; font-size: 32rpx; font-weight: 650; }
.empty-action { margin-top: 30rpx; }
.archived-list { opacity: .72; }

.form-sheet {
  overflow: hidden;
  padding: 8rpx 26rpx 28rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: 0 18rpx 44rpx rgba(89, 82, 58, .07);
}
.form-field { padding-top: 24rpx; }
.form-field + .form-field { border-top: 1rpx solid var(--color-separator); }
.form-label { display: block; color: var(--color-muted); font-size: 23rpx; font-weight: 600; }
.form-sheet input,
.form-sheet .input { margin-bottom: 20rpx; background: transparent; padding-left: 0; padding-right: 0; }
.submit-button { margin-top: 28rpx; }

@media (prefers-reduced-motion: reduce) {
  .trip-row { transition: none; }
  .hero-action:active { transform: none; }
}
